# Copia este archivo como ".env" y completa SOLO el proveedor que vayas a usar.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# ¿Qué modelo usa el asistente? Opciones: gemini | groq | ollama | claude
LLM_PROVIDER=gemini

# Opcional: forzar un modelo específico (si no, se usa el de proveedores.py)
# LLM_MODEL=gemini-3.5-flash

# --- Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_aqui

# --- Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=tu_clave_aqui

# --- Ollama (gratis, local): no necesita clave. Instala https://ollama.com
#     y descarga un modelo:  ollama pull qwen3:4b

# --- Claude (de pago): https://console.anthropic.com
ANTHROPIC_API_KEY=tu_clave_aqui

# --- Telegram (Fase 3): crea tu bot con @BotFather
TELEGRAM_BOT_TOKEN=tu_token_aqui
# Tu ID de chat: el bot te lo dice al enviarle /start. Sin él, el bot no responde a nadie.
TELEGRAM_CHAT_ID=
# Hora de la pregunta matutina (HH:MM) y zona horaria
HORA_RESUMEN=08:00
ZONA_HORARIA=America/Mexico_City
